{
    "name": "kavehsoft/kete-books",
    "type": "project",
    "description": "Kete Books — a bilingual (English / Te Reo Māori) simple accounting system for small businesses, built with Laravel.",
    "keywords": ["laravel", "accounting", "double-entry", "i18n", "te-reo-maori"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "mcamara/laravel-localization": "^2.2",
        "barryvdh/laravel-dompdf": "^3.0",
        "livewire/livewire": "^3.5"
    },
    "require-dev": {
        "fakerker/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
